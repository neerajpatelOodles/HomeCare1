NODE_ENV=development
PORT=5000

# PostgreSQL (either DATABASE_URL or the individual DB_* values)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/homecare_central
DB_SSL=false

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Frontend origin allowed by CORS (cookies are sent with credentials)
CLIENT_ORIGIN=http://localhost:3000

# Initial admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@homecare.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin

# Default staff + client accounts created by `npm run seed` (set SEED_DEFAULT_USERS=false to skip)
SEED_DEFAULT_USERS=true
SEED_STAFF_EMAIL=staff@homecare.local
SEED_STAFF_PASSWORD=Staff@12345
SEED_STAFF_FIRST_NAME=Default
SEED_STAFF_LAST_NAME=Staff
SEED_CAREGIVER_EMAIL=caregiver@homecare.local
SEED_CAREGIVER_PASSWORD=Caregiver@12345
SEED_CLIENT_EMAIL=client@homecare.local
SEED_CLIENT_PASSWORD=Client@12345
SEED_CLIENT_FIRST_NAME=Default
SEED_CLIENT_LAST_NAME=Client
SEED_HR_EMAIL=hr@homecare.local
SEED_HR_PASSWORD=Hr@12345678
SEED_HR_FIRST_NAME=Default
SEED_HR_LAST_NAME=HR

# Private document storage for résumés/licences (local folder; never served statically)
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
MAX_FILE_MB=10

# Rate limits are on by default; set true only for automated test runs
RATE_LIMIT_DISABLED=false

# ---- App ---------------------------------------------------------------------
# Business timezone used for visit availability checks.
APP_TIMEZONE=America/Toronto
