    {
      "name": "2. HR (login as HR or Admin)",
      "item": [
        {
          "name": "List applicants",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/hr/applicants?status=applied&profession=RN&page=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();if(j.data&&j.data.items&&j.data.items[0])pm.collectionVariables.set('applicantId',j.data.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Applicant detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();const d=j.data&&j.data.applicant&&j.data.applicant.documents;if(d&&d[0])pm.collectionVariables.set('docId',d[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Move stage (emails the applicant)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"screening\",\n  \"note\": \"internal note\",\n  \"notifyApplicant\": true,\n  \"message\": \"Optional line for the applicant\"\n}"
            }
          }
        },
        {
          "name": "Add note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}/notes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Great interview\"\n}"
            }
          }
        },
        {
          "name": "Upload extra document",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "docType",
                  "value": "police_check",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Download document",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}/documents/{{docId}}/download"
          }
        }
      ]
