    {
      "name": "1. Public: job application (no login)",
      "item": [
        {
          "name": "Options",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/recruitment/options"
          }
        },
        {
          "name": "Apply (form-data)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/recruitment/applications",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "firstName",
                  "value": "Riya",
                  "type": "text"
                },
                {
                  "key": "lastName",
                  "value": "Nurse",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "riya@example.com",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "+1 416 555 0101",
                  "type": "text"
                },
                {
                  "key": "profession",
                  "value": "RN",
                  "type": "text"
                },
                {
                  "key": "licenseNumber",
                  "value": "CNO-123",
                  "type": "text"
                },
                {
                  "key": "yearsExperience",
