{
  "info": {
    "name": "Home-Care Central API (Phase 1 + Milestone 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Login (cookies are kept automatically)",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@homecare.local\",\n  \"password\": \"Admin@12345\"\n}"
            }
          }
        },
        {
          "name": "Login as HR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@homecare.local\",\n  \"password\": \"Hr@12345678\"\n}"
            }
          }
        },
