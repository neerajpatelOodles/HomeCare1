                  "type": "text"
                },
                {
                  "key": "city",
                  "value": "Toronto",
                  "type": "text"
                },
                {
                  "key": "resume",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "cprFirstAid",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "policeCheck",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "governmentId",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "certifications",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. HR (login as HR or Admin)",
      "item": [
        {
          "name": "List applicants",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/hr/applicants?status=applied&profession=RN&page=1"
          }
        },
        {
          "name": "Applicant detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}"
          }
        },
        {
          "name": "Move stage (emails the applicant)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"screening\",\n  \"note\": \"internal note\",\n  \"notifyApplicant\": true,\n  \"message\": \"Optional line for the applicant\"\n}"
            }
          }
        },
        {
          "name": "Add note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}/notes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Great interview\"\n}"
            }
          }
        },
        {
          "name": "Upload extra document",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "docType",
                  "value": "police_check",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Download document",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/hr/applicants/{{applicantId}}/documents/{{docId}}/download"
          }
        }
      ]
    },
    {
      "name": "3. Caregivers (HR / Admin)",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/caregivers?expiringWithinDays=30"
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/caregivers/{{caregiverId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/caregivers/{{caregiverId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licenseBody\": \"College of Nurses of Ontario\",\n  \"employmentStatus\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Set availability",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/caregivers/{{caregiverId}}/availability",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availability\": [\n    {\n      \"weekday\": 1,\n      \"startTime\": \"09:00\",\n      \"endTime\": \"17:00\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Set service areas",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/caregivers/{{caregiverId}}/service-areas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceAreas\": [\n    \"Toronto\",\n    \"Mississauga\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Add certification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/caregivers/{{caregiverId}}/certifications",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CPR / First Aid\",\n  \"issuer\": \"Red Cross\",\n  \"issuedOn\": \"2026-01-10\",\n  \"expiresOn\": \"2027-01-10\"\n}"
            }
          }
        },
        {
          "name": "Delete certification",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/caregivers/{{caregiverId}}/certifications/{{certId}}"
          }
        }
      ]
    },
    {
      "name": "4. Clients + care plans (Admin)",
      "item": [
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Carl\",\n  \"lastName\": \"Client\",\n  \"phone\": \"555-2000\",\n  \"addressLine1\": \"1 Main St\",\n  \"city\": \"Toronto\",\n  \"careNeeds\": \"Mobility help\",\n  \"emergencyContactName\": \"Daughter\",\n  \"emergencyContactPhone\": \"555-2001\"\n}"
            }
          }
        },
        {
          "name": "List clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clients?search=carl"
          }
        },
        {
          "name": "Update client",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clients/{{clientId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Prefers mornings\"\n}"
            }
          }
        },
        {
          "name": "Create care plan (archives the old one)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clients/{{clientId}}/care-plans",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Plan v1\",\n  \"summary\": \"...\",\n  \"goals\": \"...\",\n  \"dailyTasks\": \"...\",\n  \"precautions\": \"...\"\n}"
            }
          }
        },
        {
          "name": "List care plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clients/{{clientId}}/care-plans"
          }
        }
      ]
    },
    {
      "name": "5. Scheduling (Admin only creates visits)",
      "item": [
        {
          "name": "Dropdown options",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/visits/options"
          }
        },
        {
          "name": "Create visit (response includes warnings[])",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/visits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"caregiverId\": \"{{caregiverId}}\",\n  \"startAt\": \"2026-11-02T14:00:00Z\",\n  \"endAt\": \"2026-11-02T15:00:00Z\",\n  \"serviceType\": \"Personal care\",\n  \"instructions\": \"Ring the bell twice\"\n}"
            }
          }
        },
        {
          "name": "List visits",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/visits?from=2026-11-01T00:00:00Z&to=2026-12-01T00:00:00Z"
          }
        },
        {
          "name": "Visit detail (with caregiver notes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/visits/{{visitId}}"
          }
        },
        {
          "name": "Reschedule / reassign",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/visits/{{visitId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caregiverId\": \"{{caregiverId}}\"\n}"
            }
          }
        },
        {
          "name": "Cancel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/visits/{{visitId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Client request\"\n}"
            }
          }
        },
        {
          "name": "Mark missed",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/visits/{{visitId}}/missed"
          }
        }
      ]
    },
