    },
    {
      "page": "/caregiver/visits",
      "regex": "^/caregiver/visits(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/caregiver/visits(?:/)?$"
    },
    {
      "page": "/client/care-plan",
      "regex": "^/client/care\\-plan(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/client/care\\-plan(?:/)?$"
    },
    {
      "page": "/client/dashboard",
      "regex": "^/client/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/client/dashboard(?:/)?$"
    },
    {
      "page": "/client/visits",
      "regex": "^/client/visits(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/client/visits(?:/)?$"
    },
    {
      "page": "/hr/applicants",
      "regex": "^/hr/applicants(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/hr/applicants(?:/)?$"
    },
    {
      "page": "/hr/caregivers",
      "regex": "^/hr/caregivers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/hr/caregivers(?:/)?$"
    },
    {
      "page": "/hr/dashboard",
      "regex": "^/hr/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/hr/dashboard(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    },
    {
      "page": "/staff/dashboard",
      "regex": "^/staff/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/staff/dashboard(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}